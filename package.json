{
  "name": "convex-cloudflare-email",
  "version": "0.1.0-beta.0",
  "description": "Durable email sending with Cloudflare Email Service for Convex.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "convex",
    "component",
    "cloudflare",
    "email"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./test": "./src/test.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/client/index.d.ts",
  "scripts": {
    "dev": "convex dev",
    "codegen": "convex codegen --component-dir src/component",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:release && npm run build && npm run check:package",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs",
    "test:release": "node --test scripts/*.test.mjs"
  },
  "peerDependencies": {
    "convex": "^1.45.0"
  },
  "dependencies": {
    "@convex-dev/workpool": "^0.4.11"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "^24.0.0",
    "convex": "1.45.0",
    "convex-test": "0.0.56",
    "prettier": "^3.9.5",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamtrip-solutions/convex-cloudflare-email.git"
  },
  "homepage": "https://github.com/adamtrip-solutions/convex-cloudflare-email#readme",
  "bugs": {
    "url": "https://github.com/adamtrip-solutions/convex-cloudflare-email/issues"
  }
}
